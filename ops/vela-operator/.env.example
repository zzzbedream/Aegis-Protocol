# Copy to ops/vela-operator/.env (git-ignored) and fill in. NEVER commit real keys.
# Keys: generate fresh ones with Vela's keytool (ops/README.md, step 2). The public dev keys from
# vela/dockerfiles/.env.dev must NOT be used on a public chain: anyone could sign state updates.

VELA_IMAGE_TAG=v0.2.0
INTERNAL_NETWORK_SUBNET='10.10.40.0/24'

# --- Chain: Horizen testnet (Caldera). The manager builds protocol://address:port, so the
# endpoint's "/http" path rides on the port field.
CHAIN_ID='2651420'
CHAIN_RPC_PROTOCOL='https'
CHAIN_RPC_ADDRESS='horizen-testnet.rpc.caldera.xyz'
CHAIN_RPC_PORT='443/http'
# The indexer (graph-node) uses its own RPC so its block downloads do not exhaust Caldera's
# per-IP bandwidth limit and starve the manager ("429 Bandwidth limit exceeded").
SUBGRAPH_RPC_URL='https://2651420.rpc.thirdweb.com'
# From the Vela core deployment (ops/README.md, step 3)
CHAIN_PROCESSOR_ADDRESS=''
CHAIN_TEEAUTHENTICATOR_ADDRESS=''
SUBGRAPH_START_BLOCK=''
BLOCKCHAIN_POLLING_INTERVAL='5'
BLOCKCHAIN_CONNECT_TIMEOUT='20'
REORG_TIMEOUT='180'
HANDSHAKE_TIMEOUT='10'

# --- Executor (no Nitro attestation, fixed keyset)
CHANNEL_TYPE='tcp'
EXECUTOR_IP_HOST='10.10.40.10'
EXECUTOR_PORT='4000'
EXECUTOR_VSOCK_CID='20'
EXECUTOR_KEYSET_RECOVERY_TYPE='0'
EXECUTOR_FUEL_PRICE_PER_UNIT='1'
EXECUTOR_MIN_FEE_PER_REQUEST='10'
EXECUTOR_MAX_CACHED_MODULES='0'
EXECUTOR_LOG_KIND='zeronetwork'
EXECUTOR_LOG_NETWORK_LEVEL='info'
EXECUTOR_COMMUNICATION_PARAMS_REQUEST_TIMEOUT_SEC='30'
# secp256k1 private key (hex, no 0x); its address is TEE_SIGNER_ADDRESS
EXECUTOR_FIXED_SIGNING_KEY=''
# P-521 private key (hex); its public key is TEE_PUB_P521
EXECUTOR_FIXED_COMMUNICATION_KEY=''
# AES-256 state key (hex)
EXECUTOR_FIXED_STATE_KEY=''

# --- Manager (its address is UPDATE_STATUS_OPERATOR; it pays gas for stateUpdates: fund it)
MANAGER_KEY_SECP256=''
MANAGER_IP_HOST='10.10.40.20'
MANAGER_VSOCK_CID='3'
MANAGER_ADMIN_PORT='4002'
MANAGER_ADMIN_SERVER_HOST='0.0.0.0'
MANAGER_ADMIN_COMMUNICATION_PARAMS_REQUEST_TIMEOUT_SEC='30'
MANAGER_COMMUNICATION_PARAMS_REQUEST_TIMEOUT_SEC='30'
MANAGER_LOG_KIND='zeronetwork'
MANAGER_LOG_NETWORK_LEVEL='info'
# The manager hosts the log server; the executor reaches it on the manager's internal IP.
LOG_SERVER_IP_HOST='10.10.40.20'
LOG_SERVER_PORT=5000
LOG_SERVER_CONSOLE='true'

# --- Authority service
AUTHORITY_SERVICE_IP_ADDRESS='10.10.40.40'
AUTHORITY_SERVICE_LISTEN_ADDRESS=':8081'
AUTHORITY_SERVICE_NONCE_TTL='300'
DEPLOY_ARTIFACTS_MAX_SIZE_MB='50'
AUTHORITY_SERVICE_LOG_CONSOLE='true'
AUTHORITY_SERVICE_LOG_CONSOLE_LEVEL='info'

# --- Subgraph (internal network only)
SUBGRAPH_DB_PASSWORD=''
