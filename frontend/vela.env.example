# Copy to frontend/.env.local and fill in once Horizen grants Vela access (the live Horizen testnet values are in docs/DEMO.md).
# Every value must come from the actual deployment; the app stays disabled while any is missing.
VITE_NETWORK_NAME="Vela · Base Sepolia"
VITE_CHAIN_ID=84532
VITE_VELA_PROCESSOR_ENDPOINT=
VITE_VELA_TEE_AUTHENTICATOR=
VITE_AEGIS_APP_ID=
VITE_USDC_ADDRESS=
VITE_ZEN_ADDRESS=
# Max request fee in wei (ETH); unused part is refunded by the ProcessorEndpoint.
VITE_MAX_FEE_WEI=100000000000000
# Optional: public link to the demo video, shown in the "not configured" banner.
VITE_DEMO_VIDEO_URL=

# --- Self-operated Horizen testnet demo (ops/README.md). Values come from
# vela-app/trigger/deployments/2651420.json after the deploy.
# VITE_NETWORK_NAME="Horizen testnet · Aegis demo operator"
# VITE_CHAIN_ID=2651420
# VITE_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
# VITE_EXPLORER_URL=https://explorer-testnet.horizen.io
# Lower bound for event scans (the RPC caps eth_getLogs at 100,000 blocks)
VITE_DEPLOY_BLOCK=
# Honest demo banner + trust panel (no Nitro attestation) and the test-token faucet
VITE_DEMO_OPERATOR=false
VITE_DEMO_FAUCET=false
